<#import "output.ftlx" as output>

<#macro spanOrDivTag isNested><#if isNested>span<#else>div</#if></#macro>

<#macro headLine style>${cssUtil.getHeadingTag(style)}</#macro>
<#-- @ftlvariable name="context" type="com.mgmtp.a12.print.engine.runtime.internal.engine.provider.element.markup.text.TextBasedElementHtmlTemplateParameters" -->
<#-- @ftlvariable name="cssUtil" type="com.mgmtp.a12.print.engine.runtime.internal.engine.rendering.CssUtil" -->
<#-- content must be in one line to avoid wrong calculation because of the extra spaces -->
<#if context.textStyle?? && cssUtil.getHeadingTag(context.textStyle) != "">
<<@headLine style=context.textStyle /> class="${cssUtil.getCssClasses(context.element, context.nestingType)}" id="${context.element.id!""}" style="${cssUtil.getStyle(context.element, context.placeableReference, context.textStyle, context.nestingType, context.isHtml, context.referenceInputSourceResolver)}"><@output.output value=context.evaluatedValue html=context.isHtml /></<@headLine style=context.textStyle />><#else><<@spanOrDivTag isNested=context.nestingType.isNested() /> class="${cssUtil.getCssClasses(context.element, context.nestingType)}" id="${context.element.id!""}" style="${cssUtil.getStyle(context.element, context.placeableReference, context.textStyle, context.nestingType, context.isHtml, context.referenceInputSourceResolver)}"><@output.output value=context.evaluatedValue html=context.isHtml /></<@spanOrDivTag isNested=context.nestingType.isNested() />></#if>
