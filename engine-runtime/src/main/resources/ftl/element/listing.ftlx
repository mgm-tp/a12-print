<#-- @ftlvariable name="cssUtil" type="com.mgmtp.a12.print.engine.runtime.internal.engine.rendering.CssUtil" -->
<#-- @ftlvariable name="context" type="com.mgmtp.a12.print.engine.runtime.internal.engine.provider.element.markup.listing.ListingHtmlTemplateParameters" -->
<table class="${cssUtil.getCssClasses(context.listing)}" id="${context.listing.id}"
	   style="-fs-table-paginate: paginate; ${cssUtil.getStyle(context.listing, context.placeableReference, context.textStyle, context.referenceInputSourceResolver)}">
	<colgroup>
	<#list context.colGroups as column>
		<col <#if column.present>width="${column.get()}%"</#if>/>
	</#list>
	</colgroup>
	<thead>
		<#if context.headerCells??>
			<@listingHead headerCells=context.headerCells listing=context.listing textStyle=context.headerTextStyle referenceInputSourceResolver=context.referenceInputSourceResolver />
		</#if>
	</thead>
	<tbody>
		<@listingBody listing=context.listing rows=context.rows />
	</tbody>
</table>

<#macro headLine textStyle>${cssUtil.getHeadingTag(textStyle)}</#macro>
<#macro cellStyle cssUtil listing row cell textStyle>class="listing_cell" style="${cssUtil.getHeadingSemanticListingCellStyle(listing, row, cell, context.textStyle)}"</#macro>

<#macro listingHead listing textStyle referenceInputSourceResolver  headerCells>
	<tr>
		<#-- @ftlvariable name="listing" type="com.mgmtp.a12.print.model.api.model.element.type.listing.Listing" -->
		<#-- @ftlvariable name="textStyle" type="com.mgmtp.a12.print.model.api.model.textStyle.TextStyle" -->
		<#-- @ftlvariable name="headerCells" type="java.util.List<String>" -->
		<#list headerCells as cell>
			<th class="listing_cell" style="${cssUtil.getListingHeaderCellStyle(listing, textStyle, referenceInputSourceResolver)}">
				${cell}
			</th>
		</#list>
	</tr>
</#macro>

<#macro listingBody listing rows>
<#-- @ftlvariable name="listing" type="com.mgmtp.a12.print.model.api.model.element.type.listing.Listing" -->
<#-- @ftlvariable name="rows" type="java.util.List<com.mgmtp.a12.print.engine.runtime.internal.engine.provider.element.markup.listing.ListingHtmlTemplateParameters.MarkupListingRowValue>" -->
	<#list rows as row>
		<#if !cssUtil.getListingRowHidden(row)>
			<tr>
			<#-- <tr style="${cssUtil.getListingRowStyle(listing, row, context.textStyle)}"> -->
				<#list row.columnValues as cell>
					<#if !cssUtil.getListingCellHidden(cell)>
						<td class="listing_cell" <#noautoesc>${cssUtil.getListingCellColumnSpan(cell)}</#noautoesc> style="${cssUtil.getListingCellStyle(listing, row, cell, context.textStyle, context.referenceInputSourceResolver)}">
							<#if !cssUtil.getListingCellContentHidden(cell)>
								<#assign usedTextStyle=(cssUtil.getListingCellTextStyle(cell, context.getTextStyle())) />
								<#if usedTextStyle.present && cssUtil.getHeadingTag(usedTextStyle.get()) != "">
									<<@headLine textStyle=context.textStyle /> <@cellStyle cssUtil=cssUtil listing=listing row=row cell=cell textStyle=context.textStyle />><#if cell.HTML><#noautoesc>${cell.getValue()}</#noautoesc><#else>${cell.getValue()}</#if></<@headLine textStyle=context.textStyle />>
								<#else>
									<#if cell.HTML><#noautoesc>${cell.getValue()}</#noautoesc><#else>${cell.getValue()}</#if>
								</#if>
							</#if>
						</td>
					</#if>
				</#list>
			</tr>
		</#if>
	</#list>
</#macro>
