<#import "css/header-style.ftlx" as css>
<#import "segment/segment.ftlx" as segment>
<#-- variable definitions for IDE -->

<#-- @ftlvariable name="context" type="com.mgmtp.a12.print.engine.runtime.internal.engine.provider.segment.SegmentHtmlTemplateParameters" -->
<!DOCTYPE html PUBLIC "-//OPENHTMLTOPDF//DOC XHTML Character Entities Only 1.0//EN" "">
<html lang="${(context.accessibilityMetadata.language)!""}">

	<head>
		<title>${(context.accessibilityMetadata.title)!""}</title>
		<meta name="author" content="${(context.accessibilityMetadata.author)!""}"/>
		<meta name="subject" content="${(context.accessibilityMetadata.title)!""}"/>
		<meta name="description" content="${(context.accessibilityMetadata.description)!""}"/>
		<link href="classpath:/ftl/main.css" rel="stylesheet" type="text/css" media="all"/>
		<@css.headerStyle
			containerId=(context.containerId)
			pageOrientation=(context.pageOrientation)
			totalPageCount=((context.totalPageCount)!0)
			sections=((context.sections)![])
			overflowHidden=context.overflowHidden!false
			pageNumberGlobalStyles=context.pageNumberGlobalStyles
			isInSection=context.inSection!false
		/>
	</head>
	<body <#if context.evaluatedSegmentHeight?has_content>style="height: ${context.evaluatedSegmentHeight!1}mm;"</#if> >
		<#list context.headerMarkups![] as markup>
			<#noautoesc>${markup}</#noautoesc>
		</#list>
		<@segment.segment
			id=context.containerId
			evaluatedSegmentHeight=context.evaluatedSegmentHeight
			childElementComments=context.getSortedChildElementComments()
			markup=context.markup
		/>
		<#list context.footerMarkups![] as markup>
			<#noautoesc>${markup}</#noautoesc>
		</#list>
	</body>
</html>
