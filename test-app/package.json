{
  "name": "@com.mgmtp.a12.print/test-app",
  "version": "4.0.1",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "The Print Test App",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "playwright test --project=chromium",
    "start": "webpack-dev-server",
    "clean": "pnpm run /^clean:.*/",
    "fix": "pnpm run /^.*:fix$/",
    "chromium": "npx playwright install chromium",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.json",
    "compile:check-cd": "madge --circular src/main/typescript",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "pretest": "pnpm run chromium",
    "test:report": "cross-env TEST_REPORT=true pnpm run test",
    "test:silent": "pnpm run test --ignore-snapshots",
    "test:ui": "pnpm run test  --ui",
    "test:silent:ui": "pnpm run test --ui --ignore-snapshots",
    "start:debug": "webpack-dev-server --env debug",
    "start:test": "webpack-dev-server --env test",
    "clean:lib": "rimraf lib",
    "clean:build": "rimraf build",
    "clean:coverage": "rimraf coverage",
    "clean:playwright": "rimraf playwright-report test-results"
  },
  "dependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.print/print-fonts": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api-utils": "workspace:*",
    "@com.mgmtp.a12.print/print-model-editor-component": "workspace:*",
    "@com.mgmtp.a12.print/print-typesetting": "workspace:*",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12",
    "@reduxjs/toolkit": "catalog:",
    "moment-timezone": "catalog:",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "redux": "catalog:",
    "redux-saga": "catalog:",
    "yjs": "catalog:",
    "immer": "catalog:"
  },
