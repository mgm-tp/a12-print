    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@jambit/eslint-plugin-typed-redux-saga": "catalog:",
    "@playwright/test": "catalog:",
    "@pmmmwh/react-refresh-webpack-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-redux": "catalog:",
    "@types/webpack-env": "catalog:",
    "babel-loader": "catalog:",
    "body-parser": "catalog:",
    "copy-webpack-plugin": "catalog:",
    "cross-env": "catalog:",
    "css-loader": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
