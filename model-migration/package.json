{
  "name": "@com.mgmtp.a12.print/print-model-migration",
  "version": "4.0.1",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Model Migration",
  "type": "module",
  "scripts": {
    "compile": "pnpm run compile:typescript && pnpm run lint && pnpm run format",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "clean": "rimraf coverage build lib",
    "generate-step": "pnpm run generate-step:print-model && pnpm run generate-step:print-setting-model && pnpm run generate-step:typesetting-model",
    "generate-schema": "pnpm run generate-schema:print-model && pnpm run generate-schema:print-setting-model && pnpm run generate-schema:typesetting-model",
    "fix": "pnpm run /^.*:fix$/",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest -i --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest -i --coverage",
    "generate-step:print-model": "migration-tool-utils generate-step --config migration-tool.print-model.config.json",
    "generate-step:print-setting-model": "migration-tool-utils generate-step --config migration-tool.print-setting-model.config.json",
    "generate-step:typesetting-model": "migration-tool-utils generate-step --config migration-tool.typesetting-model.config.json",
    "generate-schema:print-model": "migration-tool-utils compile --config migration-tool.print-model.config.json && pnpm run update-model-version print-model",
    "generate-schema:print-setting-model": "migration-tool-utils compile --config migration-tool.print-setting-model.config.json && pnpm run update-model-version print-setting-model",
    "generate-schema:typesetting-model": "migration-tool-utils compile --config migration-tool.typesetting-model.config.json && pnpm run update-model-version typesetting-model",
    "update-model-version": "tsx ./src/main/typescript/internal/scripts/update-model-version.ts",
    "cli:pm": "tsx ./src/main/typescript/internal/print-model/cli.ts",
    "cli:psm": "tsx ./src/main/typescript/internal/print-setting-model/cli.ts",
    "cli:ptsm": "tsx ./src/main/typescript/internal/typesetting-model/cli.ts",
    "migrate-all": "tsx ./src/main/typescript/internal/scripts/migrate-all.ts"
  },
  "bin": {
    "print-model-migration": "src/main/bin/print-model-migration.cjs",
    "print-setting-migration": "src/main/bin/print-setting-migration.cjs",
    "print-typesetting-migration": "src/main/bin/print-typesetting-migration.cjs"
  },
  "files": [
    "package.json",
    "lib",
    "src/main/bin",
    "src/main/typescript",
    "licenses",
    "cyclonedx.json",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "exports": {
    ".": "./lib/index.js"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@com.mgmtp.a12.migrationtool/migrationtool-core": "catalog:a12"
  },
  "devDependencies": {
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.migrationtool/migrationtool-utils": "catalog:a12",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api-utils": "workspace:*",
    "@com.mgmtp.a12.print/print-typesetting": "workspace:*",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "nanoid": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.print/print-model-api": "workspace:^",
    "@com.mgmtp.a12.print/print-model-api-utils": "workspace:^",
    "@com.mgmtp.a12.print/print-typesetting": "workspace:^",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12Ranges",
    "nanoid": "catalog:"
  }
}
