{
  "name": "@com.mgmtp.a12.print/print-integration",
  "version": "4.1.1",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Integration",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "clean": "rimraf lib coverage build",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "typedoc": "typedoc --tsconfig tsconfig.build.json",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --coverage"
  },
  "files": [
    "package.json",
    "lib",
    "src/main/typescript",
    "cyclonedx.json",
    "licenses",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "devDependencies": {
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.client/client-core": "catalog:a12",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12",
    "@com.mgmtp.a12.formengine/formengine-core": "catalog:a12",
    "@com.mgmtp.a12.overviewengine/overviewengine-core": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@jest/globals": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/big.js": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "jest-junit": "catalog:",
    "lodash": "catalog:",
    "prettier": "catalog:",
    "redux": "catalog:",
    "redux-saga": "catalog:",
    "rimraf": "catalog:",
    "typed-redux-saga": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12Ranges",
    "@com.mgmtp.a12.client/client-core": "catalog:a12Ranges",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12Ranges",
    "@com.mgmtp.a12.formengine/formengine-core": "catalog:a12Ranges",
    "@com.mgmtp.a12.overviewengine/overviewengine-core": "catalog:a12Ranges",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12Ranges",
    "redux": "catalog:",
    "redux-saga": "catalog:",
    "typed-redux-saga": "catalog:"
  }
}
