                      "type": "Rule",
                      "id": "rule_95807",
                      "name": "mustHaveValidRoleValues",
                      "Rule": {
                        "errorEntityRelPath": "../value",
                        "errorCode": "Error rule_95807",
                        "errorCondition": "[name] == \"roles\" And [value] PatternViolated \"^([_a-zA-Z][,-_.a-zA-Z0-9]*)\"",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Roles must only consist of letters, digits, hyphens, underscores and periods. Roles may only start with an underscore or letter. E.g. \"admin, sysAdmin\""
                          },
                          {
                            "locale": "de",
                            "text": "Rollen dürfen nur aus Buchstaben, Ziffern, Bindestrichen, Unterstrichen und Punkten bestehen. Rollen dürfen nur mit einem Buchstaben oder Unterstrich beginnen. Zum Beispiel: „admin“, „sysAdmin“."
                          }
                        ]
