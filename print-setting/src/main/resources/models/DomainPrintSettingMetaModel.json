                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "The chosen role is not present in the roles file present in the workspace."
                          },
                          {
                            "locale": "de",
                            "text": "Die gewählte Rolle ist nicht in der im Arbeitsbereich vorhandenen Rollen-Datei enthalten."
