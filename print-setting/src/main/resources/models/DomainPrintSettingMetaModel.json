                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "The values of the field must be unique."
                          },
                          {
                            "locale": "de",
                            "text": "Die Werte in diesem Feld müssen eindeutig sein."
                          }
