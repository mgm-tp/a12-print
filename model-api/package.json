{
  "name": "@com.mgmtp.a12.print/print-model-api",
  "version": "3.2.5",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Model API",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "clean": "rimraf lib coverage src/main/typescript/generated",
    "generate": "pnpm run generate:print-model-dto",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "typedoc": "typedoc --tsconfig tsconfig.build.json",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "compile:check-cd": "madge --circular src/main/typescript",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:fix:antlr": "eslint ./src/main/typescript/generated/internal/antlr/datetimeformat/DateTimeFormatParser.ts --ext .ts,.tsx --fix --no-ignore",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "format:fix:antlr": "prettier --write \"./src/main/typescript/generated/internal/antlr/datetimeformat/*.{ts,tsx}\"",
    "fix:antlr": "pnpm run /^.*:fix:antlr$/",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --coverage",
    "generate:print-model-dto": "tsx ./src/main/typescript/generator/cli-print-model-dto-generator.ts"
  },
  "config": {
    "print_meta_model_preprocessing": {
      "print_model_file": "src/main/typescript/generated/internal/model/DomainPrintMetaModel.json",
      "element_model_file": "src/main/typescript/generated/internal/model/DomainElementDefinition.json",
      "typescript_output_dir": "src/main/typescript/generated/internal/",
      "build_output_dir": "build/generated/printMetaModel/main"
    }
  },
  "files": [
    "package.json",
    "lib",
    "src/main/typescript",
    "cyclonedx.json",
    "licenses",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*.json": "./lib/*.json",
    "./errors": "./lib/errors/index.js",
    "./generated": "./lib/generated/*",
    "./input-source": "./lib/input-source/index.js",
    "./generator": "./lib/generator/index.js",
    "./model": "./lib/model/index.js",
    "./utils": "./lib/utils/index.js",
    "./walker": "./lib/walker/index.js"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@com.mgmtp.a12.utils/utils-collections": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@jest/globals": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/md5": "catalog:",
    "@types/node": "catalog:",
    "antlr4": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "lodash": "catalog:",
    "madge": "catalog:",
    "md5": "catalog:",
    "nanoid": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12Ranges",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12Ranges",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12Ranges",
    "@com.mgmtp.a12.utils/utils-collections": "catalog:a12Ranges",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12Ranges",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12Ranges",
    "antlr4": "catalog:",
    "lodash": "catalog:",
    "md5": "catalog:",
    "nanoid": "catalog:"
  }
}
