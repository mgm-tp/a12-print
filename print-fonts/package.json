{
  "name": "@com.mgmtp.a12.print/print-fonts",
  "version": "4.0.1",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Fonts",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "clean": "rimraf coverage lib build",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "compile:check-cd": "madge --circular src/main",
    "compile:copy-fonts": "cpx src/main/resources/**/* lib/resources",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --coverage"
  },
  "files": [
    "package.json",
    "lib",
    "src/main/typescript",
    "cyclonedx.json",
    "licenses",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "exports": {
    ".": "./lib/types/font.js",
    "./a12internal": "./lib/a12internal/index.js"
  },
  "typesVersions": {
    "*": {
      "a12internal": [
        "./lib/a12internal/index.d.ts"
      ]
    }
  },
  "types": "./lib/types/font.d.ts",
  "devDependencies": {
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "cpx2": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "identity-obj-proxy": "catalog:",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "madge": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
