{
  "extends": "./node_modules/@com.mgmtp.a12.print/print-dev-tools/tsconfig.json",
  "include": ["src/main/typescript/**/*", "src/test/typescript/**/*"],
  "compilerOptions": {
    "outDir": "./lib",
    "rootDirs": ["./src/main/typescript", "./src/test/typescript"],
    "types": ["jest", "node"],
    "typeRoots": ["src/main/typescript/internal/types/antlr4", "node_modules/@types"]
  },
  "typedocOptions": {
    "name": "Print Model API Utils",
    "out": "./build/docs/typedoc",
    "theme": "default",
    "excludeInternal": "true",
    "excludePrivate": "false",
    "readme": "none",
    "entryPoints": ["src/main/typescript/"],
    "entryPointStrategy": "expand",
    "exclude": ["**/a12internal/**/*"]
  }
}
