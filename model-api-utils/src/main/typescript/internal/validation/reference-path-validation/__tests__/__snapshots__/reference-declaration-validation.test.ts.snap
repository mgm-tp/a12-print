exports[`validateModelReferenceDeclarations - Print Model References reports the reference as broken when the model is missing from the workspace 1`] = `
{
  "header": {
    "modelReferences": [
      {},
      {
        "@error": [
          "The referenced Print Model 'ReferencedModel' does not exist",
        ],
      },
    ],
  },
}
`;

