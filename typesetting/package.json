{
  "name": "@com.mgmtp.a12.print/print-typesetting",
  "version": "4.0.1",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Typesetting",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "start": "webpack-dev-server --config ./webpack.config.cjs",
    "clean": "rimraf lib coverage build --glob src/main/typescript/**/generated",
    "generate": "pnpm run /^generate:.*/",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "compile:check-cd": "madge --circular src/main",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --coverage",
    "generate:typesetting-model-dto": "tsx ./src/main/typescript/internal/api/generator/cli-typesetting-model-dto-generator.ts",
    "generate:typesetting-static-models": "tsx ./src/main/typescript/internal/api/generator/cli-hyphenator-generator.ts"
  },
  "config": {
    "typesetting_model_preprocessing": {
      "typesetting_model_file": "src/main/typescript/internal/api/generated/model/DomainTypesettingMetaModel.json",
      "build_output_dir": "build/generated/typesettingModel/main",
      "typescript_output_dir": "src/main/typescript/internal/api/generated/",
      "typesetting_static_models": "src/main/resources/patterns/models"
    }
  },
  "files": [
    "package.json",
    "lib",
    "src/main/typescript",
    "cyclonedx.json",
    "licenses",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "exports": {
    "./a12internal/api": "./lib/a12internal/api/index.js",
    "./a12internal/ui": "./lib/a12internal/ui/index.js"
  },
  "typesVersions": {
    "*": {
      "a12internal/api": [
        "./lib/a12internal/api/index.d.ts"
      ],
      "a12internal/ui": [
        "./lib/a12internal/ui/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "md5": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api-utils": "workspace:*",
    "@com.mgmtp.a12.utils/utils-collections": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization-react": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
