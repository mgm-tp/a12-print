        class="c23"
      >
        <button
          aria-label="Delete selected elements"
          class="c24 c25 button button--icon button--destructive button--secondary"
          data-role="button"
          data-type="icon"
          data-variant-type="secondary"
          title="Delete selected elements"
          type="button"
        >
          <i
            class="c3 c4 plasma-icon"
            data-role="plasma-icon"
          >
            <span
              aria-hidden="true"
              class="notranslate"
              translate="no"
            >
              delete
            </span>
          </i>
        </button>
        <button
          aria-label="Copy selected elements"
          class="c24 c26 button button--icon button--secondary"
          data-role="button"
          data-type="icon"
          data-variant-type="secondary"
          title="Copy selected elements"
          type="button"
        >
          <i
            class="c3 c4 plasma-icon"
            data-role="plasma-icon"
          >
            <span
              aria-hidden="true"
              class="notranslate"
              translate="no"
            >
              content_copy
            </span>
          </i>
        </button>
        <button
          aria-label="Group selected elements into Area"
          class="c24 c26 button button--icon button--secondary"
          data-role="button"
          data-type="icon"
          data-variant-type="secondary"
          title="Group selected elements into Area"
          type="button"
        >
          <i
            class="c3 c4 plasma-icon"
            data-role="plasma-icon"
          >
            <span
              aria-hidden="true"
              class="notranslate"
              translate="no"
            >
              padding
            </span>
          </i>
        </button>
      </div>
      <button
        aria-label="Open Detail Edit"
        class="c24 c26 button button--icon button--secondary"
        data-role="button"
        data-type="icon"
        data-variant-type="secondary"
        title="Open Detail Edit"
        type="button"
      >
        <i
          class="c3 c4 plasma-icon"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
            class="notranslate"
            translate="no"
          >
            edit_note
          </span>
        </i>
      </button>
      <button
        aria-label="Open/Close Element Library"
        class="c24 c27 button button--secondary"
        data-role="button"
        data-variant-type="secondary"
        disabled=""
        title="Open/Close Element Library"
        type="button"
      >
        <i
          class="c3 c4 plasma-icon"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
            class="notranslate"
            translate="no"
          >
            category
          </span>
        </i>
        <span
          data-role="button-label"
        >
          Element Library
        </span>
      </button>
    </div>
  </div>
</div>
`;
