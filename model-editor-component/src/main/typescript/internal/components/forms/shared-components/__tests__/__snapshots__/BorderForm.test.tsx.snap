                          data-role="toggle-option-button"
                        >
                          <button
                            aria-pressed="false"
                            class="c12 c13 c14 c19 toggle__item c16"
                            data-role="toggle-item"
                            id="DEFAULT"
                            tabindex="-1"
                            title="Default Value"
                            type="button"
                            value="DEFAULT"
                          >
                            <span
                              class="c17 c18 toggle__content"
                              data-role="toggle-item-content"
                            >
                              <i
                                class="c8 c9 plasma-icon"
                                data-role="plasma-icon"
                                style="margin: 0px;"
                              >
                                <span
                                  aria-hidden="true"
                                >
                                  settings_applications
                                </span>
                              </i>
                            </span>
                          </button>
                        </li>
                        <li
                          class="c11"
                          data-role="toggle-option-button"
                        >
                          <button
                            aria-pressed="true"
                            class="c12 c13 c14 c15 toggle__item toggle__item--selected c16"
                            data-role="toggle-item"
                            id="INPUT"
                            tabindex="-1"
                            title="Enter User Input"
                            type="button"
                            value="INPUT"
                          >
                            <span
                              class="c17 c18 toggle__content"
                              data-role="toggle-item-content"
                            >
                              <i
                                class="c8 c9 plasma-icon"
                                data-role="plasma-icon"
                                style="margin: 0px;"
                              >
                                <span
                                  aria-hidden="true"
                                >
                                  edit
                                </span>
                              </i>
                            </span>
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
                <span
                  class="c34 supported-unseen-span"
                />
                <input
                  class="c35 field__text"
                  data-role="text-field-input"
                  id="color"
                  style="opacity: 0;"
                  type="color"
                  value=""
                />
                <span
                  class="c34 supported-unseen-span"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
