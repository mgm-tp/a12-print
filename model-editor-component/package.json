  "description": "Print model editor component",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --expose-gc --no-compilation-cache --no-warnings node_modules/jest/bin/jest -i",
    "clean": "rimraf build coverage lib",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json && webpack --config webpack.bundle-deps.cjs",
    "compile:check-cd": "madge --circular src/main/typescript",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest -i --watchAll",
    "test:report": "node --max-old-space-size=4096 --experimental-vm-modules --no-warnings node_modules/jest/bin/jest -i --coverage"
  },
