{
  "name": "@com.mgmtp.a12.print/print-documentation",
  "version": "3.2.4",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "The AsciiDoc of the Print Engine",
  "private": true,
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "clean": "pnpm run /^clean:.*/",
    "fix": "pnpm run /^.*:fix$/",
    "build": "pnpm run clean:build && pnpm run build:docs",
    "touch-sourceCode": "pnpm run /^touch-sourceCode:.*/",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "clean:build": "rimraf ./build",
    "clean:dist": "rimraf ./dist",
    "clean:sourceCode": "rimraf ./src/main/asciidoc/print-technical-documentation/sourceCode",
    "build:docs": "ts-node src/main/scripts/generateAllDocs.ts",
    "touch-sourceCode:root": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode",
    "touch-sourceCode:runtime": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode/engine-runtime",
    "touch-sourceCode:runtime-test": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode/engine-runtime-test",
    "touch-sourceCode:api": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode/engine-api",
    "touch-sourceCode:shell": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode/print-shell",
    "touch-sourceCode:runtime-xml": "mkdirp ./src/main/asciidoc/print-technical-documentation/sourceCode/engine-runtime-xml/src/main/java/com/mgmtp/a12/print/engine/runtime/xml/"
  },
  "devDependencies": {
    "@asciidoctor/core": "catalog:",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@types/fs-extra": "catalog:",
    "@types/glob": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "fs-extra": "catalog:",
    "glob": "catalog:",
    "mkdirp": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
