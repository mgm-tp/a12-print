{
  "name": "@com.mgmtp.a12.print/print-engine-runtime-kernel",
  "version": "3.2.5",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "description": "Print Engine Runtime Kernel",
  "type": "module",
  "scripts": {
    "compile": "pnpm run /^compile:.*/",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest",
    "clean": "rimraf lib coverage build src/main/typescript/internal/generated",
    "watch": "tsc -p tsconfig.build.json -w",
    "fix": "pnpm run /^.*:fix$/",
    "typedoc": "typedoc --tsconfig tsconfig.build.json",
    "compile:lint": "pnpm run lint && pnpm run format",
    "compile:typescript": "tsc -p tsconfig.build.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:fix:antlr": "eslint ./src/main/typescript/internal/generated/antlr/PrintComputationTSParser.ts --ext .ts,.tsx --fix --no-ignore",
    "format:fix": "prettier --write \"./*.{js,cjs,mjs}\" \"src/**/*.{ts,tsx}\"",
    "format:fix:antlr": "prettier --write \"src/main/typescript/internal/generated/antlr/*.{ts,tsx}\"",
    "fix:antlr": "pnpm run /^.*:fix:antlr$/",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --watchAll",
    "test:report": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest --coverage"
  },
  "config": {
    "print_grammar_generation": {
      "typescript_output_dir": "src/main/typescript/internal/generated"
    }
  },
  "files": [
    "package.json",
    "lib",
    "src/main/typescript",
    "cyclonedx.json",
    "licenses",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "main": "lib/internal/index.js",
  "dependencies": {
    "antlr4": "catalog:",
    "big.js": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.print/print-dev-tools": "workspace:*",
    "@com.mgmtp.a12.print/print-model-api": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/big.js": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "lodash": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "ts-node": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12Ranges",
    "@com.mgmtp.a12.print/print-model-api": "workspace:^",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12Ranges",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-ts": "catalog:a12Ranges",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12Ranges"
  }
}
